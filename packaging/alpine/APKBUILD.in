# Precompiled and audited CI cross binaries; abuild only signs and packages.
# Generated version and checksum are supplied by build-ci-alpine-apk.sh.
pkgname=nuraloumi
pkgver=@PKGVER@
pkgrel=0
pkgdesc="Native Wayland touch shell for Tegra20 ARMv7"
maintainer="NuraLoumi maintainers <26308101+fkr-0@users.noreply.github.com>"
url="https://github.com/fkr-0/nuraloumi"
arch="armv7"
license="MIT"
# The CI's readelf allowlist below is the authority for direct NEEDED SONAMEs.
# This copy-only recipe has explicit Alpine runtime dependencies: do not
# silently trace dependencies against the throwaway build container.
depends="musl cairo libgcc libxkbcommon wayland-libs-client"
options="!check !strip !tracedeps"
source="nuraloumi-stage.tar.gz"
builddir="$srcdir/bundle"

package() {
    install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/nuraloumi" "$pkgdir/usr/share/nuraloumi/qualification" \
        "$pkgdir/usr/share/licenses/nuraloumi"
    local binary count=0
    for binary in "$builddir"/bin/nuraloumi-*; do
        [ -x "$binary" ] || return 1
        install -m755 "$binary" "$pkgdir/usr/bin/${binary##*/}" || return 1
        count=$((count+1))
    done
    [ "$count" -ge 4 ] || return 1
    install -m644 "$builddir/config/nuraloumi.toml.example" "$pkgdir/usr/share/nuraloumi/nuraloumi.toml.example"
    install -m644 "$builddir/share/nuraloumi/qualification/README.md" "$pkgdir/usr/share/nuraloumi/qualification/README.md"
    install -m644 "$builddir/MANIFEST.txt" "$pkgdir/usr/share/nuraloumi/CI-MANIFEST.txt"
    install -m644 "$builddir/LICENSE" "$pkgdir/usr/share/licenses/nuraloumi/LICENSE"
    install -m644 "$builddir/README.md" "$pkgdir/usr/share/nuraloumi/README"
}
