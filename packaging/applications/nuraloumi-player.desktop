[Desktop Entry]
Type=Application
Name=NuraLoumi Media Player
GenericName=Audio Player
Comment=Native audio playback (GPU video not supported)
Exec=nuraloumi-player %f
TryExec=nuraloumi-player
Icon=multimedia-player
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/mp4;audio/aac;audio/ogg;audio/opus;audio/flac;audio/x-wav;
StartupNotify=false
